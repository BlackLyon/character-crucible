<Project>

  <!-- Settings shared by every project in the solution. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Windows Smart App Control blocks the unsigned apphost .exe that the SDK
         generates. Without one, dotnet run launches via the Microsoft-signed
         dotnet host instead. Costs nothing: container images run `dotnet App.dll`. -->
    <UseAppHost>false</UseAppHost>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
