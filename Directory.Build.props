<Project>

  <!-- Settings shared by every project in the solution. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Windows Smart App Control blocks the unsigned apphost .exe that the SDK
         generates. Without one, dotnet run launches via the Microsoft-signed
         dotnet host instead. Costs nothing: container images run `dotnet App.dll`. -->
    <UseAppHost>false</UseAppHost>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Run the .editorconfig code-style rules during build, not just in the IDE.
         Without this, IDExxxx rules are IDE-only and a naming violation ships. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Arms the IDE1006 naming rule: a warning alone does not stop a lowercase public
         property reaching a published snapshot, and no CI enforces -warnaserror. Scoped to
         this one rule so an unused variable mid-refactor does not block the build. -->
    <WarningsAsErrors>IDE1006</WarningsAsErrors>
  </PropertyGroup>

</Project>
