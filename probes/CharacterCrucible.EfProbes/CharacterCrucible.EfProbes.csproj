<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- For its EF and Npgsql packages only, so the probes always run on the bits the app ships.
       A separate pin here could drift and leave the probes green against an older EF. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\CharacterCrucible.CoreApi\CharacterCrucible.CoreApi.csproj" />
  </ItemGroup>

</Project>
